    {
      "id": 9,
      "title": "🦕 Dino Runner",
      "type": "text",
      "gridPos": { "x": 0, "y": 63, "w": 24, "h": 10 },
      "options": {
        "mode": "html",
        "content": "<div style='background:#050d1a;border:1px solid #1a3a5c;border-radius:8px;padding:12px;font-family:monospace'><div style='text-align:center;color:#4a9eff;font-size:10px;letter-spacing:3px;margin-bottom:6px'>🦕 DINO RUNNER — CLICK OR SPACE TO START</div><canvas id='dino_c' width='700' height='160' style='background:#030810;border:1px solid #1e3a5f;display:block;margin:0 auto;cursor:pointer;max-width:100%'></canvas></div><script>(function(){var c=document.getElementById('dino_c'),ctx=c.getContext('2d'),W=c.width,H=c.height,GY=H-28,state='idle',sc=0,fr=0,spd=5,ot=0,oi=80,hi=parseInt(localStorage.getItem('dino_hi')||'0'),dino={x:60,y:GY,vy:0,j:false,lf:0},obs=[],clds=[];function jump(){if(!dino.j&&state==='running'){dino.vy=-14;dino.j=true;}}function drawD(){var x=dino.x,y=dino.y,col=state==='dead'?'#ff4444':'#00d4ff';ctx.fillStyle=col;ctx.fillRect(x+18,y-54,20,14);ctx.fillRect(x+30,y-44,10,6);ctx.fillStyle='#030810';ctx.fillRect(x+32,y-52,4,4);ctx.fillStyle=col;ctx.fillRect(x+10,y-42,26,10);ctx.fillRect(x+6,y-34,24,16);ctx.fillRect(x,y-34,8,8);ctx.fillRect(x+2,y-42,8,10);var l1=dino.lf<5;if(dino.j){ctx.fillRect(x+10,y-18,10,18);ctx.fillRect(x+20,y-18,10,14);}else{ctx.fillRect(x+10,y-18,10,l1?18:10);ctx.fillRect(x+20,y-18,10,l1?10:18);}}function drawO(o){ctx.fillStyle='#00ff88';ctx.fillRect(o.x+o.w/2-5,GY-o.h,10,o.h);ctx.fillRect(o.x,GY-o.h*0.6,o.w/2-5,8);ctx.fillRect(o.x,GY-o.h*0.8,8,o.h*0.22);if(o.big){ctx.fillRect(o.x+o.w/2+5,GY-o.h*0.6,o.w/2-5,8);ctx.fillRect(o.x+o.w-8,GY-o.h*0.8,8,o.h*0.22);}}function hit(o){var dm=6;return dino.x+36-dm>o.x+dm&&dino.x+10+dm<o.x+o.w-dm&&dino.y>GY-o.h+dm;}function update(){if(state!=='running')return;fr++;sc=Math.floor(fr/6);spd=5+Math.floor(sc/150)*0.5;dino.vy+=0.7;dino.y+=dino.vy;if(dino.y>=GY){dino.y=GY;dino.vy=0;dino.j=false;}if(!dino.j)dino.lf=Math.floor(fr/5)%10;ot++;if(ot>=oi){obs.push({x:W+10,w:Math.random()>0.5?50:30,h:50+Math.random()*30,big:Math.random()>0.5});ot=0;oi=50+Math.floor(Math.random()*55);}obs.forEach(function(o){o.x-=spd;});obs=obs.filter(function(o){return o.x>-60;});for(var i=0;i<obs.length;i++){if(hit(obs[i])){state='dead';if(sc>hi){hi=sc;localStorage.setItem('dino_hi',String(hi));}break;}}if(fr%90===0)clds.push({x:W,y:15+Math.random()*40,w:50+Math.random()*40});clds.forEach(function(cl){cl.x-=spd*0.2;});clds=clds.filter(function(cl){return cl.x>-100;});}function draw(){ctx.fillStyle='#030810';ctx.fillRect(0,0,W,H);ctx.fillStyle='#1e3a5f';ctx.fillRect(0,GY+2,W,2);var dx=Math.floor(fr*spd)%24;for(var gx=dx-24;gx<W;gx+=24){ctx.fillStyle='#0d1f36';ctx.fillRect(gx,GY+6,14,2);}ctx.fillStyle='#0a1628';clds.forEach(function(cl){ctx.fillRect(cl.x,cl.y,cl.w,8);ctx.fillRect(cl.x+8,cl.y-6,cl.w-16,6);});obs.forEach(drawO);drawD();ctx.font='11px monospace';ctx.textAlign='right';ctx.fillStyle='#4a9eff';ctx.fillText('HI '+String(hi).padStart(5,'0'),W-90,18);ctx.fillStyle='#00d4ff';ctx.fillText(String(sc).padStart(5,'0'),W-10,18);if(state==='idle'){ctx.fillStyle='#00d4ff';ctx.font='bold 13px monospace';ctx.textAlign='center';ctx.shadowColor='#00d4ff';ctx.shadowBlur=12;ctx.fillText('PRESS SPACE OR CLICK TO START',W/2,H/2);ctx.shadowBlur=0;ctx.fillStyle='#4a9eff';ctx.font='10px monospace';ctx.fillText('SPACE / UP Arrow to jump',W/2,H/2+18);}else if(state==='dead'){ctx.fillStyle='#ff4444';ctx.font='bold 14px monospace';ctx.textAlign='center';ctx.fillText('GAME OVER',W/2,H/2-8);ctx.fillStyle='#4a9eff';ctx.font='10px monospace';ctx.fillText('SPACE / CLICK to restart',W/2,H/2+12);}}function start(){if(state==='dead'){dino.y=GY;dino.vy=0;dino.j=false;dino.lf=0;obs=[];clds=[];fr=0;sc=0;ot=0;oi=80;spd=5;}state='running';}function loop(){update();draw();requestAnimationFrame(loop);}document.addEventListener('keydown',function(e){if(e.code==='Space'||e.key==='ArrowUp'){e.preventDefault();if(state!=='running')start();else jump();}});c.addEventListener('click',function(){if(state!=='running')start();else jump();});loop();}());</script>"
      }
